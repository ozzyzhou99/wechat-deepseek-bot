# Keep this file as a template. Create a private .env file locally; never commit it.

# LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=60

# Framework behavior
BOT_DISPLAY_NAME=
REPLY_ONLY_WHEN_AT=true
CONTEXT_MAX_TURNS=10
PERSONA=toxic_friend
SARCASM_LEVEL=3
CASUAL_MAX_SENTENCES=3
GROUP_NO_MENTION_FOLLOWUP_SECONDS=90
GROUP_NO_MENTION_MAX_FOLLOWUPS=2
GROUP_BREAK_SESSION_ON_OTHER_USER_MESSAGE=true
AMBIENT_REPLY_ENABLED=false
GAMES_ENABLED=true

# Privacy-first archive settings. Leave archiving disabled unless all affected
# participants have been informed and you have a lawful basis.
CHAT_ARCHIVE_ENABLED=false
CHAT_ARCHIVE_PATH=data/bot.sqlite3
CHAT_ARCHIVE_RETENTION_DAYS=1
CHAT_ARCHIVE_MAX_SUMMARY_MESSAGES=1000
APP_TIMEZONE=Asia/Shanghai

# Content safeguards
POLITICS_FILTER_ENABLED=true
POLITICS_FILTER_MODE=hybrid
POLITICS_FILTER_REPLY=这个机器人不参与政治相关讨论，换个话题吧。
LOG_LEVEL=INFO
